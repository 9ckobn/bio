    <script is:inline>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('lang');
        } catch (e) {}
        if (lang !== 'ru' && lang !== 'en') {
          lang = (navigator.language || 'en').toLowerCase().indexOf('ru') === 0 ? 'ru' : 'en';
        }
        location.replace('/' + lang + '/python/');
      })();
    </script>
