---
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaViewer from '../components/MediaViewer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImageName?: string;
  route?: string;
}

const { lang, title, description, ogImageName = 'og.png', route = '/' } = Astro.props;
const site = Astro.site ?? new URL('https://antonchuprun.site');
const path = route === '/' ? '' : route.replace(/^\//, '').replace(/\/?$/, '/');
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(`${l}/${path}`, site).href,
}));
const canonical = new URL(`${lang}/${path}`, site).href;
const ogImage = new URL(ogImageName, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1117" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved =
          stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeMode = resolved;
        if (document.startViewTransition) {
          document.documentElement.classList.add('vt');
        }
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <MediaViewer />

    
    <script is:inline>
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function getTheme() {
          try {
            var s = localStorage.getItem('theme');
            if (s === 'light' || s === 'dark') return s;
          } catch (e) {}
          return mq.matches ? 'dark' : 'light';
        }
        function applyTheme(t) {
          document.documentElement.dataset.theme = t;
          document.documentElement.dataset.themeMode = t;
        }

        applyTheme(getTheme());

        mq.addEventListener('change', function () {
          try {
            if (!localStorage.getItem('theme')) {
              applyTheme(mq.matches ? 'dark' : 'light');
            }
          } catch (e) {}
        });

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-theme-toggle]');
          if (btn) {
            var cur = document.documentElement.dataset.theme || getTheme();
            var next = cur === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem('theme', next);
            } catch (e) {}

            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduced && document.startViewTransition) {
              var rect = btn.getBoundingClientRect();
              var cx = rect.left + rect.width / 2;
              var cy = rect.top + rect.height / 2;
              var root = document.documentElement;
              root.style.setProperty('--vt-x', cx + 'px');
              root.style.setProperty('--vt-y', cy + 'px');
              document.startViewTransition(function () {
                applyTheme(next);
              });
            } else {
              applyTheme(next);
            }
            return;
          }
          var scrollBtn = e.target.closest('[data-scroll]');
          if (scrollBtn) {
            var wrap = scrollBtn.closest('.case-shots-wrap');
            var box = wrap && wrap.querySelector('.case-shots');
            if (box) {
              var dir = scrollBtn.getAttribute('data-scroll') === 'prev' ? -1 : 1;
              var step = box.clientWidth * 0.8;
              var maxScroll = Math.max(0, box.scrollWidth - box.clientWidth);
              var projectedLeft = Math.max(0, Math.min(maxScroll, box.scrollLeft + dir * step));

              updateCarouselNav(wrap, projectedLeft);

              wrap._scrollingUntil = Date.now() + 450;
              box.scrollBy({ left: dir * step, behavior: 'smooth' });
            }
            return;
          }
          var copyBtn = e.target.closest('[data-copy]');
          if (!copyBtn) return;
          var text = copyBtn.getAttribute('data-copy');
          var done = copyBtn.getAttribute('data-label-copied') || 'Copied';
          var ok = function () {
            var old = copyBtn.textContent;
            copyBtn.textContent = done;
            setTimeout(function () {
              copyBtn.textContent = old;
            }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(ok, function () {});
          } else {
            var ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand('copy');
              ok();
            } catch (err) {}
            ta.remove();
          }
        });

        function updateCarouselNav(w, projectedLeft) {
          var box = w.querySelector('.case-shots');
          if (!box) return;
          var prevBtn = w.querySelector('.shot-nav--prev');
          var nextBtn = w.querySelector('.shot-nav--next');
          var curLeft = typeof projectedLeft === 'number' ? projectedLeft : box.scrollLeft;
          var maxScroll = Math.max(0, box.scrollWidth - box.clientWidth);
          var canScrollLeft = curLeft > 2;
          var canScrollRight = curLeft < maxScroll - 2;

          if (prevBtn) {
            if (canScrollLeft) prevBtn.classList.add('is-visible');
            else prevBtn.classList.remove('is-visible');
          }
          if (nextBtn) {
            if (canScrollRight) nextBtn.classList.add('is-visible');
            else nextBtn.classList.remove('is-visible');
          }
          if (maxScroll > 2) {
            w.setAttribute('data-scrollable', '');
          } else {
            w.removeAttribute('data-scrollable');
          }
        }

        function markScrollable() {
          document.querySelectorAll('.case-shots-wrap').forEach(function (w) {
            updateCarouselNav(w);
          });
        }

        markScrollable();
        window.addEventListener('resize', markScrollable);

        document.querySelectorAll('.case-shots').forEach(function (box) {
          var wrap = box.closest('.case-shots-wrap');
          if (!wrap) return;
          box.addEventListener(
            'scroll',
            function () {
              if (wrap._scrollingUntil && Date.now() < wrap._scrollingUntil) {
                return;
              }
              updateCarouselNav(wrap);
            },
            { passive: true }
          );
          if ('onscrollend' in window) {
            box.addEventListener(
              'scrollend',
              function () {
                wrap._scrollingUntil = 0;
                updateCarouselNav(wrap);
              },
              { passive: true }
            );
          }
        });

        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('is-visible');
                  io.unobserve(en.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -24px 0px' }
          );
          document.querySelectorAll('.reveal').forEach(function (el) {
            io.observe(el);
          });

          var videoObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                var v = entry.target;
                if (entry.isIntersecting) {
                  if (!v.src && v.getAttribute('data-src')) {
                    v.src = v.getAttribute('data-src');
                  }
                  v.muted = true;
                  v.play().catch(function () {});
                } else {
                  if (v.src && !v.paused) {
                    v.pause();
                  }
                }
              });
            },
            { rootMargin: '200px 0px' }
          );
          var shotObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var img = entry.target;
                var full = img.getAttribute('data-full');
                if (!full || img.getAttribute('data-loaded') === 'true') return;
                img.setAttribute('data-loaded', 'true');
                shotObserver.unobserve(img);
                // Swap via blob URL: a plain img.src = full would re-download
                // the file when the cache is disabled and blank the tile
                // while the second request is in flight.
                if (window.fetch && window.URL && URL.createObjectURL) {
                  fetch(full)
                    .then(function (r) {
                      if (!r.ok) throw new Error('bad status');
                      return r.blob();
                    })
                    .then(function (blob) {
                      img.src = URL.createObjectURL(blob);
                    })
                    .catch(function () {
                      img.src = full;
                    });
                } else {
                  img.src = full;
                }
              });
            },
            { rootMargin: '400px 300px' }
          );
          // Full-res shots start right away: the observer only fetches what
          // is near the viewport, so media loads progressively on scroll.
          document.querySelectorAll('img.shot-img[data-full]').forEach(function (img) {
            shotObserver.observe(img);
          });
          // Videos stay deferred until window.load so their fetching never
          // delays the document load event.
          var videoLoadingStarted = false;
          var startVideoLoading = function () {
            if (videoLoadingStarted) return;
            videoLoadingStarted = true;
            document.querySelectorAll('video.case-video-player').forEach(function (v) {
              videoObserver.observe(v);
            });
          };
          if (document.readyState === 'complete') {
            startVideoLoading();
          } else {
            window.addEventListener('load', startVideoLoading);
          }
        } else {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-visible');
          });
          var startMediaFallback = function () {
            document.querySelectorAll('video.case-video-player').forEach(function (v) {
              if (v.getAttribute('data-src')) {
                v.src = v.getAttribute('data-src');
                v.play().catch(function () {});
              }
            });
            document.querySelectorAll('img.shot-img[data-full]').forEach(function (img) {
              var full = img.getAttribute('data-full');
              if (full) img.src = full;
            });
          };
          if (document.readyState === 'complete') {
            startMediaFallback();
          } else {
            window.addEventListener('load', startMediaFallback);
          }
        }

        var viewer = document.getElementById('media-viewer');
        var viewerBackdrop = document.getElementById('viewer-backdrop');
        var viewerTopBar = viewer ? viewer.querySelector('.viewer-top-bar') : null;
        var viewerClose = document.getElementById('viewer-close');
        var viewerCounter = document.getElementById('viewer-counter');
        var viewerStage = document.getElementById('viewer-stage');
        var viewerTrack = document.getElementById('viewer-track');
        var viewerPrev = document.getElementById('viewer-prev');
        var viewerNext = document.getElementById('viewer-next');
        var viewerControls = document.getElementById('viewer-controls');
        var viewerPlayPause = document.getElementById('viewer-play-pause');
        var viewerMute = document.getElementById('viewer-mute');
        var viewerCurrentTime = document.getElementById('viewer-current-time');
        var viewerDuration = document.getElementById('viewer-duration');
        var viewerScrubber = document.getElementById('viewer-scrubber');
        var viewerProgress = document.getElementById('viewer-progress');
        var viewerHandle = document.getElementById('viewer-handle');

        var currentMediaItems = [];
        var currentMediaIndex = 0;
        var currentVideoEl = null;
        var isScrubbing = false;
        var isAnimating = false;
        var touchStartX = 0;
        var touchStartY = 0;
        var touchDeltaX = 0;
        var touchDeltaY = 0;
        var isSwiping = false;
        var swipeDirection = null;

        function formatTime(s) {
          if (isNaN(s) || s < 0) return '0:00';
          var m = Math.floor(s / 60);
          var sec = Math.floor(s % 60);
          return m + ':' + (sec < 10 ? '0' : '') + sec;
        }

        function syncMediaLoadingAndPlayback(idx) {
          if (!currentMediaItems.length || !viewerTrack) return;
          var N = currentMediaItems.length;
          var activeIdx = (idx + N) % N;
          var prevIdx = (activeIdx - 1 + N) % N;
          var nextIdx = (activeIdx + 1) % N;

          [activeIdx, prevIdx, nextIdx].forEach(function (i) {
            var slide = viewerTrack.children[i];
            if (!slide) return;
            var it = currentMediaItems[i];
            if (!it) return;

            if (it.type === 'video') {
              var vid = slide.querySelector('video');
              if (vid && !vid.src) {
                if (it.poster && !vid.poster) vid.poster = it.poster;
                vid.src = it.src;
              }
            } else {
              var img = slide.querySelector('img');
              if (img && it.src) {
                if (img.getAttribute('data-full-loaded') !== 'true') {
                  var fullImg = new Image();
                  fullImg.src = it.src;
                  if (fullImg.decode) {
                    fullImg.decode().then(function () {
                      if (img) {
                        img.src = it.src;
                        img.setAttribute('data-full-loaded', 'true');
                      }
                    }).catch(function () {
                      if (img) {
                        img.src = it.src;
                        img.setAttribute('data-full-loaded', 'true');
                      }
                    });
                  } else {
                    fullImg.onload = function () {
                      if (img) {
                        img.src = it.src;
                        img.setAttribute('data-full-loaded', 'true');
                      }
                    };
                  }
                }
              }
            }
          });

          var activeSlide = viewerTrack.children[activeIdx];
          var activeVideo = activeSlide ? activeSlide.querySelector('video') : null;

          var allVideos = viewerTrack.querySelectorAll('video');
          allVideos.forEach(function (v) {
            if (v !== activeVideo) {
              v.pause();
            }
          });

          if (activeVideo) {
            currentVideoEl = activeVideo;
            if (viewerControls) viewerControls.classList.add('is-visible');
            activeVideo.muted = true;
            activeVideo.setAttribute('muted', '');
            if (viewerMute) viewerMute.classList.add('is-muted');
            if (activeVideo.readyState >= 2) {
              activeVideo.classList.add('is-playing');
            }
            activeVideo.play().then(function () {
              activeVideo.classList.add('is-playing');
            }).catch(function () {});

            activeVideo.ontimeupdate = function () {
              if (!isScrubbing && activeVideo.duration) {
                var percent = (activeVideo.currentTime / activeVideo.duration) * 100;
                if (viewerProgress) viewerProgress.style.width = percent + '%';
                if (viewerHandle) viewerHandle.style.left = percent + '%';
                if (viewerCurrentTime) viewerCurrentTime.textContent = formatTime(activeVideo.currentTime);
              }
            };
            activeVideo.onloadedmetadata = function () {
              if (viewerDuration) viewerDuration.textContent = formatTime(activeVideo.duration);
            };
            if (activeVideo.duration && viewerDuration) {
              viewerDuration.textContent = formatTime(activeVideo.duration);
            }
          } else {
            currentVideoEl = null;
            if (viewerControls) viewerControls.classList.remove('is-visible');
          }
        }

        function goTo(idx, animate) {
          if (!currentMediaItems.length || !viewerTrack) return;
          var N = currentMediaItems.length;
          currentMediaIndex = idx;

          if (viewerCounter) {
            viewerCounter.textContent = currentMediaIndex + 1 + ' / ' + N;
          }

          if (N <= 1) {
            if (viewerPrev) viewerPrev.style.display = 'none';
            if (viewerNext) viewerNext.style.display = 'none';
          } else {
            if (viewerPrev) viewerPrev.style.display = '';
            if (viewerNext) viewerNext.style.display = '';
          }

          if (!animate) {
            viewerTrack.style.transition = 'none';
          } else {
            viewerTrack.style.transition = 'transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
          }
          viewerTrack.style.transform = 'translate3d(' + -currentMediaIndex * 100 + 'vw, 0, 0)';

          syncMediaLoadingAndPlayback(currentMediaIndex);
        }

        function nextSlide() {
          if (isAnimating || currentMediaItems.length <= 1 || !viewerTrack) return;
          var N = currentMediaItems.length;
          if (currentMediaIndex < N - 1) {
            isAnimating = true;
            goTo(currentMediaIndex + 1, true);
            setTimeout(function () {
              isAnimating = false;
            }, 220);
          } else {
            isAnimating = true;
            var firstSlide = viewerTrack.children[0];
            firstSlide.style.transform = 'translate3d(' + N * 100 + 'vw, 0, 0)';
            viewerTrack.style.transition = 'transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
            viewerTrack.style.transform = 'translate3d(' + -N * 100 + 'vw, 0, 0)';
            syncMediaLoadingAndPlayback(0);
            if (viewerCounter) viewerCounter.textContent = '1 / ' + N;

            setTimeout(function () {
              firstSlide.style.transform = '';
              viewerTrack.style.transition = 'none';
              viewerTrack.style.transform = 'translate3d(0vw, 0, 0)';
              currentMediaIndex = 0;
              isAnimating = false;
            }, 220);
          }
        }

        function prevSlide() {
          if (isAnimating || currentMediaItems.length <= 1 || !viewerTrack) return;
          var N = currentMediaItems.length;
          if (currentMediaIndex > 0) {
            isAnimating = true;
            goTo(currentMediaIndex - 1, true);
            setTimeout(function () {
              isAnimating = false;
            }, 220);
          } else {
            isAnimating = true;
            var lastSlide = viewerTrack.children[N - 1];
            lastSlide.style.transform = 'translate3d(' + -N * 100 + 'vw, 0, 0)';
            viewerTrack.style.transition = 'transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
            viewerTrack.style.transform = 'translate3d(100vw, 0, 0)';
            syncMediaLoadingAndPlayback(N - 1);
            if (viewerCounter) viewerCounter.textContent = N + ' / ' + N;

            setTimeout(function () {
              lastSlide.style.transform = '';
              viewerTrack.style.transition = 'none';
              viewerTrack.style.transform = 'translate3d(' + -(N - 1) * 100 + 'vw, 0, 0)';
              currentMediaIndex = N - 1;
              isAnimating = false;
            }, 220);
          }
        }

        var closeTimer = null;
        function openViewer(items, startIndex) {
          clearTimeout(closeTimer);
          currentMediaItems = items;
          currentMediaIndex = startIndex;

          [viewerTopBar, viewerPrev, viewerNext, viewerControls, viewerBackdrop].forEach(function (el) {
            if (el) {
              el.style.opacity = '';
              el.style.transition = '';
            }
          });

          if (viewerTrack) {
            viewerTrack.innerHTML = '';
            items.forEach(function (it, idx) {
              var slide = document.createElement('div');
              slide.className = 'viewer-slide';
              slide.setAttribute('data-index', idx);
              var card = document.createElement('div');
              card.className = 'viewer-card';
              if (it.type === 'video') {
                var wrap = document.createElement('div');
                wrap.className = 'viewer-video-wrap';

                if (it.poster || it.thumb) {
                  var pImg = document.createElement('img');
                  pImg.className = 'viewer-video-poster';
                  pImg.src = it.poster || it.thumb;
                  pImg.alt = it.alt || '';
                  pImg.draggable = false;
                  wrap.appendChild(pImg);
                }

                var v = document.createElement('video');
                v.className = 'viewer-slide-video';
                if (it.poster) v.poster = it.poster;
                v.playsInline = true;
                v.muted = true;
                v.setAttribute('muted', '');
                v.loop = true;
                v.preload = 'auto';
                v.src = it.src;
                v.addEventListener('playing', function () {
                  v.classList.add('is-playing');
                });
                v.addEventListener('loadeddata', function () {
                  if (v.readyState >= 2) {
                    v.classList.add('is-playing');
                  }
                });
                v.addEventListener('click', togglePlayPause);
                wrap.appendChild(v);
                card.appendChild(wrap);
              } else {
                var img = document.createElement('img');
                img.className = 'viewer-slide-img';
                img.alt = it.alt || '';
                img.draggable = false;
                img.src = it.thumb || it.src;
                card.appendChild(img);

                if (it.src) {
                  var pre = new Image();
                  pre.src = it.src;
                }
              }
              slide.appendChild(card);
              viewerTrack.appendChild(slide);
            });
          }

          goTo(startIndex, false);

          if (viewer) {
            viewer.classList.add('is-open');
            viewer.setAttribute('aria-hidden', 'false');
          }

          document.querySelectorAll('video.case-video-player').forEach(function (v) {
            v.pause();
          });
        }

        function closeViewer(immediate) {
          if (!viewer || !viewer.classList.contains('is-open')) return;

          if (viewerTrack) {
            viewerTrack.querySelectorAll('video').forEach(function (v) {
              v.pause();
            });
          }
          currentVideoEl = null;

          if (immediate) {
            viewer.classList.remove('is-open');
            viewer.setAttribute('aria-hidden', 'true');
            if (viewerTrack) viewerTrack.innerHTML = '';
            if (viewerControls) {
              viewerControls.classList.remove('is-visible');
              viewerControls.style.opacity = '';
              viewerControls.style.transition = '';
            }
            if (viewerTopBar) {
              viewerTopBar.style.opacity = '';
              viewerTopBar.style.transition = '';
            }
            if (viewerPrev) {
              viewerPrev.style.opacity = '';
              viewerPrev.style.transition = '';
            }
            if (viewerNext) {
              viewerNext.style.opacity = '';
              viewerNext.style.transition = '';
            }
            if (viewerBackdrop) {
              viewerBackdrop.style.transition = '';
              viewerBackdrop.style.opacity = '';
            }
          } else {
            viewer.classList.remove('is-open');
            viewer.setAttribute('aria-hidden', 'true');
            clearTimeout(closeTimer);
            closeTimer = setTimeout(function () {
              if (!viewer.classList.contains('is-open')) {
                if (viewerTrack) viewerTrack.innerHTML = '';
                if (viewerControls) {
                  viewerControls.classList.remove('is-visible');
                  viewerControls.style.opacity = '';
                  viewerControls.style.transition = '';
                }
                if (viewerTopBar) {
                  viewerTopBar.style.opacity = '';
                  viewerTopBar.style.transition = '';
                }
                if (viewerPrev) {
                  viewerPrev.style.opacity = '';
                  viewerPrev.style.transition = '';
                }
                if (viewerNext) {
                  viewerNext.style.opacity = '';
                  viewerNext.style.transition = '';
                }
                if (viewerBackdrop) {
                  viewerBackdrop.style.transition = '';
                  viewerBackdrop.style.opacity = '';
                }
              }
            }, 280);
          }

          document.querySelectorAll('video.case-video-player').forEach(function (v) {
            if (!v.src) return;
            var r = v.getBoundingClientRect();
            if (r.bottom > -200 && r.top < window.innerHeight + 200) {
              v.play().catch(function () {});
            }
          });
        }

        window.addEventListener(
          'wheel',
          function (e) {
            if (viewer && viewer.classList.contains('is-open')) {
              e.preventDefault();
            }
          },
          { passive: false }
        );

        window.addEventListener(
          'touchmove',
          function (e) {
            if (viewer && viewer.classList.contains('is-open') && !e.target.closest('.viewer-controls')) {
              e.preventDefault();
            }
          },
          { passive: false }
        );

        function togglePlayPause(e) {
          if (e) e.stopPropagation();
          if (!currentVideoEl) return;
          if (currentVideoEl.paused) {
            currentVideoEl.play().catch(function () {});
            if (viewerPlayPause) viewerPlayPause.classList.remove('is-paused');
          } else {
            currentVideoEl.pause();
            if (viewerPlayPause) viewerPlayPause.classList.add('is-paused');
          }
        }

        if (viewer) {
          if (viewerClose) viewerClose.addEventListener('click', closeViewer);
          if (viewerBackdrop) viewerBackdrop.addEventListener('click', closeViewer);
          if (viewerStage) {
            viewerStage.addEventListener('click', function (e) {
              if (
                !e.target.closest('.viewer-card') &&
                !e.target.closest('#viewer-controls') &&
                !e.target.closest('.viewer-nav') &&
                !e.target.closest('.viewer-top-bar')
              ) {
                closeViewer();
              }
            });
          }
          if (viewerPrev) {
            viewerPrev.addEventListener('click', function (e) {
              e.stopPropagation();
              prevSlide();
            });
          }
          if (viewerNext) {
            viewerNext.addEventListener('click', function (e) {
              e.stopPropagation();
              nextSlide();
            });
          }

          if (viewerPlayPause) viewerPlayPause.addEventListener('click', togglePlayPause);

          if (viewerMute) {
            viewerMute.addEventListener('click', function (e) {
              e.stopPropagation();
              if (!currentVideoEl) return;
              currentVideoEl.muted = !currentVideoEl.muted;
              if (currentVideoEl.muted) {
                currentVideoEl.setAttribute('muted', '');
                viewerMute.classList.add('is-muted');
              } else {
                currentVideoEl.removeAttribute('muted');
                currentVideoEl.volume = 1;
                viewerMute.classList.remove('is-muted');
              }
            });
          }

          function seekAtEvent(e) {
            if (!viewerScrubber || !currentVideoEl) return;
            var rect = viewerScrubber.getBoundingClientRect();
            var pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            if (viewerProgress) viewerProgress.style.width = pos * 100 + '%';
            if (viewerHandle) viewerHandle.style.left = pos * 100 + '%';
            if (currentVideoEl.duration) {
              var targetTime = pos * currentVideoEl.duration;
              currentVideoEl.currentTime = targetTime;
              if (viewerCurrentTime) viewerCurrentTime.textContent = formatTime(targetTime);
            }
          }

          if (viewerScrubber) {
            viewerScrubber.addEventListener('click', function (e) {
              e.stopPropagation();
            });
            viewerScrubber.addEventListener('pointerdown', function (e) {
              e.stopPropagation();
              isScrubbing = true;
              viewerScrubber.classList.add('is-dragging');
              viewerScrubber.setPointerCapture(e.pointerId);
              seekAtEvent(e);
            });
            viewerScrubber.addEventListener('pointermove', function (e) {
              if (isScrubbing) {
                seekAtEvent(e);
              }
            });
            function endScrub(e) {
              if (isScrubbing) {
                isScrubbing = false;
                viewerScrubber.classList.remove('is-dragging');
                try {
                  viewerScrubber.releasePointerCapture(e.pointerId);
                } catch (err) {}
              }
            }
            viewerScrubber.addEventListener('pointerup', endScrub);
            viewerScrubber.addEventListener('pointercancel', endScrub);
          }

          if (viewerStage && viewerTrack) {
            viewerStage.addEventListener(
              'touchstart',
              function (e) {
                if (e.touches.length === 1 && !e.target.closest('.viewer-controls') && !isAnimating) {
                  touchStartX = e.touches[0].clientX;
                  touchStartY = e.touches[0].clientY;
                  touchDeltaX = 0;
                  touchDeltaY = 0;
                  isSwiping = true;
                  swipeDirection = null;
                  if (viewerControls) viewerControls.style.transition = 'none';
                  if (viewerTopBar) viewerTopBar.style.transition = 'none';
                  if (viewerPrev) viewerPrev.style.transition = 'none';
                  if (viewerNext) viewerNext.style.transition = 'none';
                  if (viewerBackdrop) viewerBackdrop.style.transition = 'none';
                }
              },
              { passive: true }
            );

            viewerStage.addEventListener(
              'touchmove',
              function (e) {
                if (!isSwiping || e.touches.length !== 1) return;
                touchDeltaX = e.touches[0].clientX - touchStartX;
                touchDeltaY = e.touches[0].clientY - touchStartY;

                if (!swipeDirection) {
                  if (Math.abs(touchDeltaY) > 6 || Math.abs(touchDeltaX) > 6) {
                    if (Math.abs(touchDeltaY) > Math.abs(touchDeltaX)) {
                      swipeDirection = 'vertical';
                      Array.from(viewerTrack.children).forEach(function (slide, idx) {
                        if (idx !== currentMediaIndex) {
                          slide.style.opacity = '0';
                          slide.style.pointerEvents = 'none';
                        }
                      });
                    } else {
                      swipeDirection = 'horizontal';
                      viewerTrack.classList.add('is-dragging');
                    }
                  }
                }

                if (swipeDirection === 'vertical') {
                  var absY = Math.abs(touchDeltaY);
                  var effY = Math.max(0, absY - 16);
                  var uiOpacity = Math.max(0, 1 - effY / 140);
                  var backdropOpacity = Math.max(0, 1 - effY / 260);
                  var scale = Math.max(0.75, 1 - effY / 750);

                  var activeSlide = viewerTrack.children[currentMediaIndex];
                  if (activeSlide) {
                    var card = activeSlide.querySelector('.viewer-card');
                    if (card) {
                      card.style.transform = 'translate3d(0, ' + touchDeltaY + 'px, 0) scale(' + scale + ')';
                    }
                  }
                  if (viewerBackdrop) viewerBackdrop.style.opacity = backdropOpacity;
                  if (viewerTopBar) viewerTopBar.style.opacity = uiOpacity;
                  if (viewerPrev) viewerPrev.style.opacity = uiOpacity;
                  if (viewerNext) viewerNext.style.opacity = uiOpacity;
                  if (viewerControls && currentVideoEl) viewerControls.style.opacity = uiOpacity;
                } else if (swipeDirection === 'horizontal') {
                  viewerTrack.style.transform =
                    'calc(' + -currentMediaIndex * 100 + 'vw + ' + touchDeltaX + 'px)';
                }
              },
              { passive: true }
            );

            viewerStage.addEventListener('touchend', function () {
              if (!isSwiping) return;
              isSwiping = false;
              var dir = swipeDirection;
              swipeDirection = null;
              viewerTrack.classList.remove('is-dragging');

              if (dir === 'vertical') {
                var absY = Math.abs(touchDeltaY);
                var activeSlide = viewerTrack.children[currentMediaIndex];
                var card = activeSlide ? activeSlide.querySelector('.viewer-card') : null;

                if (absY > 95) {
                  if (card) {
                    var targetY = touchDeltaY > 0 ? touchDeltaY + 240 : touchDeltaY - 240;
                    card.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.2s ease';
                    card.style.transform = 'translate3d(0, ' + targetY + 'px, 0) scale(0.55)';
                    card.style.opacity = '0';
                  }
                  if (viewerBackdrop) {
                    viewerBackdrop.style.transition = 'opacity 0.2s ease';
                    viewerBackdrop.style.opacity = '0';
                  }
                  [viewerTopBar, viewerPrev, viewerNext, viewerControls].forEach(function (el) {
                    if (el) {
                      el.style.transition = 'opacity 0.15s ease';
                      el.style.opacity = '0';
                    }
                  });
                  setTimeout(function () {
                    closeViewer(true);
                  }, 220);
                } else {
                  if (card) {
                    card.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.9, 0.3, 1)';
                    card.style.transform = '';
                    setTimeout(function () {
                      if (card) card.style.transition = '';
                    }, 240);
                  }
                  if (viewerBackdrop) {
                    viewerBackdrop.style.transition = 'opacity 0.24s ease';
                    viewerBackdrop.style.opacity = '';
                    setTimeout(function () {
                      if (viewerBackdrop) viewerBackdrop.style.transition = '';
                    }, 240);
                  }
                  [viewerTopBar, viewerPrev, viewerNext, viewerControls].forEach(function (el) {
                    if (el) {
                      el.style.transition = 'opacity 0.24s ease';
                      el.style.opacity = '';
                      setTimeout(function () {
                        if (el) el.style.transition = '';
                      }, 240);
                    }
                  });
                  Array.from(viewerTrack.children).forEach(function (slide) {
                    slide.style.opacity = '';
                    slide.style.pointerEvents = '';
                  });
                }
              } else if (dir === 'horizontal') {
                if (touchDeltaX < -50) {
                  nextSlide();
                } else if (touchDeltaX > 50) {
                  prevSlide();
                } else {
                  goTo(currentMediaIndex, true);
                }
              } else {
                goTo(currentMediaIndex, true);
              }
            });
          }

          window.addEventListener('keydown', function (e) {
            if (!viewer.classList.contains('is-open')) return;
            if (e.key === 'Escape') {
              closeViewer();
            } else if (e.key === 'ArrowLeft') {
              prevSlide();
            } else if (e.key === 'ArrowRight') {
              nextSlide();
            } else if (e.code === 'Space' && currentVideoEl) {
              e.preventDefault();
              togglePlayPause();
            } else if ((e.key === 'm' || e.key === 'M' || e.key === 'ь' || e.key === 'Ь') && currentVideoEl) {
              e.preventDefault();
              currentVideoEl.muted = !currentVideoEl.muted;
              if (currentVideoEl.muted) {
                currentVideoEl.setAttribute('muted', '');
                if (viewerMute) viewerMute.classList.add('is-muted');
              } else {
                currentVideoEl.removeAttribute('muted');
                currentVideoEl.volume = 1;
                if (viewerMute) viewerMute.classList.remove('is-muted');
              }
            }
          });

          document.addEventListener('click', function (e) {
            var shot = e.target.closest('.shot[data-media-type]');
            if (shot) {
              var parentShots = shot.closest('.case-shots');
              if (parentShots) {
                var allShots = Array.from(parentShots.querySelectorAll('.shot[data-media-type]'));
                var mediaList = allShots.map(function (el) {
                  var imgEl = el.querySelector('img');
                  return {
                    type: el.getAttribute('data-media-type'),
                    src: el.getAttribute('data-src'),
                    thumb: el.getAttribute('data-thumb') || (imgEl ? imgEl.currentSrc || imgEl.src : ''),
                    poster: el.getAttribute('data-poster') || '',
                    alt: el.getAttribute('data-alt') || el.getAttribute('data-title') || '',
                  };
                });
                var clickedIndex = allShots.indexOf(shot);
                if (clickedIndex >= 0) {
                  openViewer(mediaList, clickedIndex);
                }
              }
            }
          });

          document.addEventListener(
            'pointerover',
            function (e) {
              var shot = e.target.closest('.shot[data-media-type]');
              if (shot && !shot._preloaded) {
                shot._preloaded = true;
                var src = shot.getAttribute('data-src');
                var type = shot.getAttribute('data-media-type');
                if (src && type === 'image') {
                  var p = new Image();
                  p.src = src;
                }
              }
            },
            { passive: true }
          );

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              var shot = document.activeElement ? document.activeElement.closest('.shot[data-media-type]') : null;
              if (shot && !viewer.classList.contains('is-open')) {
                e.preventDefault();
                shot.click();
              }
            }
          });
        }
      })();
    </script>
  </body>
</html>
