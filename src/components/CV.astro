---
import { stats } from '../data/cases';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="section band" id="cv">
  <div class="wrap">
    <h2 class="section-title reveal">{tr('cv.title')}</h2>

    <div class="card reveal">
      <h3>{tr('cv.about.title')}</h3>
      {tr('cv.about.body').split('\n\n').map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <dl class="stats stats-cv">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>{s.label[lang]}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="facts">
        <span class="chip">{tr('how.format')}</span>
        <span class="chip">{tr('how.async')}</span>
        <span class="chip">{tr('how.tz')}</span>
        <span class="chip">{tr('how.payment')}</span>
      </div>
    </div>

    <div class="subsection">
      <h3 class="subsection-title reveal">{tr('cv.verticals.title')}</h3>
      <div class="cards">
        <div class="card reveal">
          <h3>{tr('services.flutter.title')}</h3>
          <p>{tr('services.flutter.body')}</p>
        </div>
        <div class="card reveal">
          <h3>{tr('services.python.title')}</h3>
          <p>{tr('services.python.body')}</p>
        </div>
        <div class="card wide reveal">
          <h3>{tr('services.pilot.title')}</h3>
          <p>{tr('services.pilot.body')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
