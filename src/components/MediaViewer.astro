---
---

<div
  id="media-viewer"
  class="media-viewer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Media viewer"
>
  <div class="viewer-backdrop" id="viewer-backdrop"></div>

  <header class="viewer-top-bar">
    <div class="viewer-pill viewer-counter" id="viewer-counter">1 / 1</div>
    <button
      type="button"
      class="viewer-btn viewer-btn--close"
      id="viewer-close"
      aria-label="Close"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </header>

  <div class="viewer-stage" id="viewer-stage">
    <div class="viewer-track" id="viewer-track"></div>
  </div>

  <button
    type="button"
    class="viewer-nav viewer-nav--prev"
    id="viewer-prev"
    aria-label="Previous item"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>
  <button
    type="button"
    class="viewer-nav viewer-nav--next"
    id="viewer-next"
    aria-label="Next item"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18l6-6-6-6" />
    </svg>
  </button>

  <div class="viewer-controls" id="viewer-controls">
    <button
      type="button"
      class="viewer-ctrl-btn"
      id="viewer-play-pause"
      aria-label="Play / Pause"
    >
      <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <polygon points="6,4 20,12 6,20" />
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <rect x="6" y="4" width="4" height="16" rx="1.5" />
        <rect x="14" y="4" width="4" height="16" rx="1.5" />
      </svg>
    </button>

    <div class="viewer-timeline">
      <span class="viewer-time viewer-time--current" id="viewer-current-time">0:00</span>
      <div
        class="viewer-scrubber"
        id="viewer-scrubber"
        role="slider"
        aria-label="Seek timeline"
        tabindex="0"
      >
        <div class="viewer-scrubber-track">
          <div class="viewer-scrubber-progress" id="viewer-progress"></div>
          <div class="viewer-scrubber-handle" id="viewer-handle"></div>
        </div>
      </div>
      <span class="viewer-time viewer-time--duration" id="viewer-duration">0:00</span>
    </div>

    <button
      type="button"
      class="viewer-ctrl-btn is-muted"
      id="viewer-mute"
      aria-label="Toggle mute"
    >
      <svg class="icon-unmuted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" />
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
      </svg>
      <svg class="icon-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" />
        <line x1="23" y1="9" x2="17" y2="15" />
        <line x1="17" y1="9" x2="23" y2="15" />
      </svg>
    </button>
  </div>
</div>
