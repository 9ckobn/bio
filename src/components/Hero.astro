---
import { Image } from 'astro:assets';
import avatarImg from '../assets/avatar.png';
import { t, type Lang } from '../i18n/ui';
import { stats } from '../data/cases';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const email = 'bergman.worker@gmail.com';
const linkedin = 'https://www.linkedin.com/in/antonchuprun-dev/';
---

<section class="hero wrap">
  <Image
    class="avatar reveal"
    src={avatarImg}
    alt="Anton Chuprun"
    width={384}
    height={384}
    loading="eager"
    fetchpriority="high"
  />
  <h1 class="reveal">Anton Chuprun</h1>
  <p class="lead reveal">{tr('hero.subtitle')}</p>

  <div class="contact-actions reveal" id="contact-top">
    <a class="button button--primary" href="#contact-form">
      {tr('hero.cta_form')}
    </a>
    <a class="button" href="https://t.me/unitony" target="_blank" rel="noopener">
      <Icon name="telegram" />
      {tr('contact.tg')}
    </a>
    <a class="button" href={`mailto:${email}`}>
      {email}
    </a>
    <a class="button" href="https://github.com/9ckobn" target="_blank" rel="noopener">
      <Icon name="github" />
      GitHub
    </a>
    <a class="button" href={linkedin} target="_blank" rel="noopener">
      <Icon name="linkedin" />
      LinkedIn
    </a>
  </div>

  <dl class="stats stats-hero reveal">
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.label[lang]}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
