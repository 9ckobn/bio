---
import { t, type Lang } from '../i18n/ui';
import { stats } from '../data/cases';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const email = 'bergman.worker@gmail.com';
const linkedin = 'https://www.linkedin.com/in/anton-chuprun-unity/';
---

<section class="hero wrap">
  <h1 class="reveal">Anton Chuprun</h1>
  <p class="lead reveal">{tr('hero.subtitle')}</p>

  <div class="contact-actions reveal" id="contact-top">
    <a class="button button--primary" href="https://tg.me/unitony" rel="noopener">
      <Icon name="telegram" />
      {tr('contact.tg')} ↗
    </a>
    <button
      class="button"
      type="button"
      data-copy={email}
      data-label-copied={tr('contact.copied')}
    >
      {tr('contact.email')}
    </button>
    <a class="button" href="https://github.com/9ckobn" target="_blank" rel="noopener">
      <Icon name="github" />
      GitHub ↗
    </a>
    <a class="button" href={linkedin} target="_blank" rel="noopener">
      <Icon name="linkedin" />
      LinkedIn ↗
    </a>
  </div>

  <dl class="stats reveal">
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.label[lang]}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
