---
import githubSvg from '../icons/github.svg?raw';
import telegramSvg from '../icons/telegram.svg?raw';
import linkedinSvg from '../icons/linkedin.svg?raw';
import appleSvg from '../icons/apple.svg?raw';
import zynerioSvg from '../icons/zynerio.svg?raw';

export type IconName = 'github' | 'telegram' | 'linkedin' | 'apple' | 'zynerio' | 'email';

interface Props {
  name: IconName;
}
const { name } = Astro.props;

const brand: Record<string, string> = {
  github: githubSvg,
  telegram: telegramSvg,
  apple: appleSvg,
  zynerio: zynerioSvg,
};
let svg: string | null = null;
if (name === 'linkedin') {
  svg = linkedinSvg.replace('<svg', '<svg width="1em" height="1em"');
} else if (name === 'zynerio') {
  svg = zynerioSvg.replace('<svg', '<svg width="1em" height="1em"');
} else if (brand[name]) {
  svg = brand[name].replace('<svg', '<svg fill="currentColor" width="1em" height="1em"');
}
---

{name === 'email' ? (
  <span class="icon icon--text" aria-hidden="true">✉&#xFE0E;</span>
) : (
  svg && <span class="icon" aria-hidden="true" set:html={svg} />
)}

<style>
  .icon {
    display: inline-flex;
    font-size: 16px;
    line-height: 0;
  }
  .icon--text {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1;
  }
  .icon-img {
    display: block;
    border-radius: 4px;
  }
</style>
