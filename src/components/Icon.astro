---
import githubSvg from '../icons/github.svg?raw';
import telegramSvg from '../icons/telegram.svg?raw';
import linkedinSvg from '../icons/linkedin.svg?raw';
import appleSvg from '../icons/apple.svg?raw';

export type IconName = 'github' | 'telegram' | 'linkedin' | 'apple' | 'zynerio';

interface Props {
  name: IconName;
}
const { name } = Astro.props;

const brand: Record<string, string> = {
  github: githubSvg,
  telegram: telegramSvg,
  apple: appleSvg,
};
let svg: string | null = null;
if (name === 'linkedin') {
  // lucide stroke icon — keep fill="none", just size it
  svg = linkedinSvg.replace('<svg', '<svg width="1em" height="1em"');
} else if (brand[name]) {
  // simple-icons glyph — needs currentColor fill
  svg = brand[name].replace('<svg', '<svg fill="currentColor" width="1em" height="1em"');
}
---

{
  name === 'zynerio' ? (
    <img class="icon-img" src="/icons/zynerio.svg" alt="" width="16" height="16" />
  ) : (
    svg && <span class="icon" aria-hidden="true" set:html={svg} />
  )
}

<style>
  .icon {
    display: inline-flex;
    font-size: 16px;
    line-height: 0;
  }
  .icon-img {
    display: block;
    border-radius: 4px;
  }
</style>
